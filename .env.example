# Copy this file to .env and fill in your values. Never commit .env.

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Which Gemini model the agent uses (gemini-3.8-flash has a free tier)
GEMINI_MODEL=gemini-3.8-flash

# How much the model thinks before answering: minimal | low | medium | high
# Lower = faster and fewer tokens, higher = more thorough.
GEMINI_THINKING_LEVEL=medium

# Postgres from docker-compose (host port 5433 -> container port 5432)
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5433/research_agent

# Guardrails against runaway loops and cost
MAX_STEPS=8
RUN_TIMEOUT_SECONDS=180
